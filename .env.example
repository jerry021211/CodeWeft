# Conversation model shared by main Agent, subagents, memory and (by default) summary.
# Web: use sidebar > Model settings. Saved settings/models.json overrides model variables here.
# Protocol: anthropic | openai_chat | openai_responses. Never inferred from model name.
MODEL_PROTOCOL=anthropic
# For OpenAI-compatible APIs set API_KEY/BASE_URL or OPENAI_API_KEY/OPENAI_BASE_URL.
# BASE_URL must include the API prefix, e.g. https://api.openai.com/v1
# Optional known model capabilities: text,image,document,audio (not all protocols support audio).
MODEL_INPUT_MODALITIES=
# OpenAI protocols: explicitly list reasoning levels supported by YOUR endpoint/model.
MODEL_REASONING_LEVELS=
# Legacy compatible Chat servers may require max_tokens instead.
OPENAI_CHAT_TOKEN_PARAMETER=max_completion_tokens
# Conversation model identifier; Web can be configured from the settings page on first launch.
MODEL_ID=deepseek-v4-pro

# Required when using a hosted model API.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: custom Anthropic-compatible endpoint.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional runtime settings.
MAX_TOKENS=32000
# 推理等级：default（官方默认）、none（关闭）、low、high、max。
# 当前支持 DeepSeek 官方 Anthropic 兼容接口；单次任务可覆盖。
REASONING_EFFORT=default
MAX_ITERATIONS=50
# Recommended for the Web cockpit so text_delta events arrive in real time.
STREAMING=true
# Independent speech-to-text model. Never inherits the chat API key or endpoint.
# Uses the OpenAI-compatible /audio/transcriptions endpoint; WAV/MP3 uploads.
CODEAGENT_SPEECH_ENABLED=false
CODEAGENT_SPEECH_MODEL=
CODEAGENT_SPEECH_BASE_URL=
CODEAGENT_SPEECH_API_KEY=
CODEAGENT_SPEECH_LANGUAGE=
CODEAGENT_SPEECH_TIMEOUT=120
CODEAGENT_PLANNING_MODE=auto
# Tavily web search. Off by default; the Web toggle / CLI flags override per run.
TAVILY_API_KEY=
CODEAGENT_WEB_SEARCH_ENABLED=false
CODEAGENT_WEB_SEARCH_TIMEOUT=20
# Maximum concurrent Web root runs; 1 restores serial execution. Team workers are separate.
CODEAGENT_WEB_MAX_CONCURRENT_RUNS=4

# Ordinary Run-local parallelism; false restores serial tool dispatch.
CODEAGENT_PARALLEL_ENABLED=true
CODEAGENT_PARALLEL_TOOLS=4
CODEAGENT_PARALLEL_SUBAGENTS=3
CODEAGENT_SUBAGENT_QUEUE_LIMIT=16
# Process-wide admission limits, loaded on first use; restart after changes.
CODEAGENT_MAX_CONCURRENT_MODELS=8
CODEAGENT_MAX_CONCURRENT_SUBAGENTS=8
CODEAGENT_MAX_CONCURRENT_TOOLS=16

# Single-agent loop protection (normal, discuss, ordinary subagents; not Team).
# Initial tuning values; positive except retries, retry delay and token cap may be 0.
CODEAGENT_LOOP_WINDOW=12
CODEAGENT_LOOP_REPEAT_FAILURE_LIMIT=3
CODEAGENT_LOOP_PARAMETER_ERROR_LIMIT=2
CODEAGENT_LOOP_BLOCKED_ATTEMPT_LIMIT=3
CODEAGENT_LOOP_EMPTY_RESPONSE_LIMIT=2
CODEAGENT_LOOP_TOOL_MAX_RETRIES=2
CODEAGENT_LOOP_RETRY_DELAY_SECONDS=0.25
CODEAGENT_RUN_MAX_MODEL_CALLS=80
CODEAGENT_RUN_MAX_TOOL_CALLS=200
# Reported input + cache creation/read + output tokens; disabled by default (0).
# Set a positive value to opt into a cumulative token cap for each run.
CODEAGENT_RUN_MAX_TOTAL_TOKENS=0
CODEAGENT_RUN_MAX_ACTIVE_SECONDS=1800

# Optional MCP client config. A missing file simply disables MCP.
MCP_CONFIG=mcp.json

# Optional runtime system prompt assembly settings.
PROMPT_TEMPLATE_DIR=.prompts
SYSTEM_PROMPT_BUDGET_CHARS=120000
SYSTEM_PROMPT_STATIC_BUDGET_CHARS=50000
SYSTEM_PROMPT_DYNAMIC_BUDGET_CHARS=70000
SKILL_CATALOG_BUDGET_CHARS=12000
PROMPT_TRACE=false

# Optional error recovery settings.
RECOVERY_ENABLED=true
FALLBACK_MODEL_ID=
RECOVERY_TRACE=false

# Optional LangSmith tracing settings.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=CodeAgent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Shell subprocesses do not inherit tracing by default, avoiding orphan test/probe traces.
CODEAGENT_TRACE_SUBPROCESSES=false
# Optional: max characters per traced string field before local truncation.
LANGSMITH_TRACE_MAX_STRING_CHARS=20000

# Shared skill library for all projects and workspaces.
# Relative paths resolve under CODEAGENT_DATA_DIR; absolute paths are also supported.
ENABLE_SKILLS=true
SKILLS_DIR=skills

# Optional long-term memory settings.
ENABLE_MEMORY=true
MEMORY_DIR=.memory
MEMORY_MAX_ITEMS_IN_PROMPT=50
MEMORY_MAX_LOADED_ITEMS=5
MEMORY_SESSION_BUDGET_CHARS=60000
MEMORY_MAX_MEMORY_BYTES=50000
MEMORY_SELECTION_MODE=llm
MEMORY_RETRIEVAL_MODE=indexed
MEMORY_INDEX_VERIFY_SECONDS=60
MEMORY_AUTO_EXTRACT=false
MEMORY_EXTRACT_RECENT_MESSAGES=12
MEMORY_CONSOLIDATE_THRESHOLD=30
MEMORY_CONSOLIDATE_MODE=simple
MEMORY_ALLOW_SUBAGENT_WRITE=false

# CodeAgent-owned state, memory, context artifacts, and relative Team Worktrees
# live outside user Git repositories. Override this root when needed.
CODEAGENT_DATA_DIR=

# Optional context compaction settings.
CONTEXT_COMPACT_MODE=model
SUMMARIZATION_MODEL_ID=
SUMMARIZATION_API_KEY=
CONTEXT_TOOL_RESULT_BUDGET_CHARS=200000
CONTEXT_SINGLE_TOOL_OUTPUT_MAX_CHARS=80000
# Command logs above this size use searchable head/tail previews; 0 disables this extra threshold.
CONTEXT_COMMAND_OUTPUT_MAX_CHARS=12000
# Short references only when the exact earlier read remains in the request view.
CONTEXT_READ_REFERENCE_ENABLED=true
# Legacy CONTEXT_COMPACT_THRESHOLD_CHARS is accepted but no longer triggers compaction.
# Cache-friendly request views: auto uses known cheap-prefix providers only when
# the actual model window is known. Unknown windows do not trigger auto-compaction.
# legacy uses the total-token window ratio; all policies retain stable cleaned views.
CONTEXT_CACHE_POLICY=auto
# Preserve existing 20% headroom in the model window after output reservation.
CONTEXT_CACHE_SOFT_RATIO=0.8
# Batch further rewrites after 10% token capacity growth; hard token limits bypass this.
CONTEXT_CACHE_BOUNDARY_GROWTH_RATIO=0.1
# Characters, not tokens; retry oversized output once.
CONTEXT_SUMMARY_MAX_CHARS=4000
# Independent completion-token safety budget (may include reasoning); reserve before sending.
CONTEXT_SUMMARY_MAX_TOKENS=8192
CONTEXT_TRANSCRIPT_DIR=.transcripts
CONTEXT_TOOL_OUTPUT_DIR=.task_outputs/tool-results
CONTEXT_REACTIVE_RETRIES=1
# Retain complete recent conversation messages / assistant execution rounds.
CONTEXT_RECENCY_MESSAGES=12
CONTEXT_RECENCY_ROUNDS=2
CONTEXT_MIN_FOLD_MESSAGES=4
CONTEXT_MAX_FOLD_MESSAGES=200
CONTEXT_MAX_FOLD_ROUNDS=12
# Complete serialized request budgets, including system and tool schemas.
# Legacy CONTEXT_MAX_REQUEST_CHARS is ignored; requests use the model token window.
CONTEXT_SUMMARY_INPUT_MAX_CHARS=120000
# 0 = unknown model window: enforce characters, do not guess a provider window.
# When using fallback models, set the minimum supported window across them.
CONTEXT_WINDOW_TOKENS=0
CONTEXT_SUMMARY_WINDOW_TOKENS=0
# Optional per-model windows, including smaller fallback models. Values are tokens.
CONTEXT_MODEL_WINDOWS_JSON={}
CONTEXT_NEAR_CONTEXT_RATIO=0.8
CONTEXT_SUMMARY_TEXT_PREVIEW_CHARS=4000
CONTEXT_SUMMARY_ARGUMENT_PREVIEW_CHARS=2000
CONTEXT_FAILURE_COOLDOWN_SECONDS=90
CONTEXT_SUMMARY_TIMEOUT_SECONDS=45
# Pressure-driven tool cleanup is independent of semantic summary mode.
# Legacy MESSAGE_TRIGGER_MIN_FOLD / ROUND_TRIGGER_MIN_FOLD values are accepted but ignored.
CONTEXT_TOOL_PROJECTION_ENABLED=true
CONTEXT_INVESTIGATION_KEEP_ROUNDS=2
CONTEXT_COMMAND_KEEP_ROUNDS=1
CONTEXT_WRITE_KEEP_ROUNDS=2
CONTEXT_TOOL_CLEAR_MIN_CHARS=8000
CONTEXT_WRITE_CLEAR_MIN_CHARS=8000
# Agent Team is opt-in. The write flag has no effect unless the runtime flag is enabled.
TEAM_RUNTIME_ENABLED=false
TEAM_WRITE_ENABLED=false
# Relative paths are resolved under CODEAGENT_DATA_DIR, never inside the source repository.
TEAM_WORKTREE_ROOT=.codeagent-worktrees

# Optional semantic code search. Explicit opt-in; credentials are separate from chat.
# Use the compatible-mode endpoint for your remote provider / business workspace.
CODEAGENT_EMBEDDING_ENABLED=false
CODEAGENT_EMBEDDING_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CODEAGENT_EMBEDDING_MODEL=qwen3.7-text-embedding
CODEAGENT_EMBEDDING_DIMENSIONS=1024
CODEAGENT_EMBEDDING_API_KEY=
CODEAGENT_EMBEDDING_TIMEOUT=10
CODEAGENT_EMBEDDING_MAX_CHUNKS=2000
# MAX_CHUNKS is a per-build budget; subsequent queries resume missing blocks.
CODEAGENT_EMBEDDING_BATCH_SIZE=20

# LSP servers are discovered locally; queries never download language servers.
CODEAGENT_LSP_ENABLED=true
CODEAGENT_LSP_TIMEOUT=5
CODEAGENT_LSP_FEEDBACK_TIMEOUT=1.5
# Optional JSON arrays of executable + arguments; leave unset for discovery.
# CODEAGENT_PYTHON_LSP_COMMAND=["pylsp"]
# CODEAGENT_TYPESCRIPT_LSP_COMMAND=["typescript-language-server","--stdio"]
# CODEAGENT_JAVA_LSP_COMMAND=["jdtls"]
# CODEAGENT_JAVA_LSP_SETTINGS={"java":{"configuration":{"runtimes":[]}}}
# CODEAGENT_TYPESCRIPT_LSP_INITIALIZATION_OPTIONS={"tsserver":{"path":"absolute/path/to/tsserver.js","useSyntaxServer":"never"}}
